{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A finished attempt, format version 6",
  "description": "The structure and limits of an attempt: a fight of the game, a level of its journey or a battle of the duel with the King of robbers. The server also checks the energy of a battle by backend/schema/energy.json (§24.4); the other rules of the game stay in frontend/src/domain. Version 6 leaves the old modes of the site and their ready-made challenges behind, and the API accepts this version only. Section 3.7 of the plan.",
  "oneOf": [
    { "$ref": "#/definitions/fightAttempt" },
    { "$ref": "#/definitions/campaignAttempt" },
    { "$ref": "#/definitions/duelAttempt" }
  ],
  "definitions": {
    "fightAttempt": {
      "description": "A fight of the game the player puts together (§6). It always takes the energy of fights.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "startedAt", "finishedAt", "durationMs", "game", "mode", "config", "result"],
      "properties": {
        "schemaVersion": { "const": 6 },
        "id": { "$ref": "#/definitions/attemptId" },
        "startedAt": { "$ref": "#/definitions/instant" },
        "finishedAt": { "$ref": "#/definitions/instant" },
        "durationMs": { "$ref": "#/definitions/duration" },
        "game": { "$ref": "#/definitions/fightBattleGame" },
        "mode": { "enum": ["fight"] },
        "config": { "$ref": "#/definitions/fightConfig" },
        "result": { "$ref": "#/definitions/fightGridResult" }
      }
    },
    "campaignAttempt": {
      "description": "A level of the journey of the game (§24.5). It takes the energy of the journey.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "startedAt", "finishedAt", "durationMs", "game", "mode", "config", "result"],
      "properties": {
        "schemaVersion": { "const": 6 },
        "id": { "$ref": "#/definitions/attemptId" },
        "startedAt": { "$ref": "#/definitions/instant" },
        "finishedAt": { "$ref": "#/definitions/instant" },
        "durationMs": { "$ref": "#/definitions/duration" },
        "game": { "$ref": "#/definitions/campaignGame" },
        "mode": { "enum": ["campaign"] },
        "config": { "$ref": "#/definitions/campaignConfig" },
        "result": { "$ref": "#/definitions/campaignResult" }
      }
    },
    "duelAttempt": {
      "description": "A battle of the duel with the King of robbers, the final battle of the journey (§24.9). It takes the energy of the journey.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "startedAt", "finishedAt", "durationMs", "game", "mode", "config", "result"],
      "properties": {
        "schemaVersion": { "const": 6 },
        "id": { "$ref": "#/definitions/attemptId" },
        "startedAt": { "$ref": "#/definitions/instant" },
        "finishedAt": { "$ref": "#/definitions/instant" },
        "durationMs": { "$ref": "#/definitions/duration" },
        "game": { "$ref": "#/definitions/campaignGame" },
        "mode": { "enum": ["duel"] },
        "config": { "$ref": "#/definitions/duelConfig" },
        "result": { "$ref": "#/definitions/duelResult" }
      }
    },

    "fightConfig": {
      "description": "The exercises of a fight with the repetitions of every round; every exercise has as many rounds (§6).",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "exercises"],
      "properties": {
        "mode": { "enum": ["fight"] },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "sets"],
            "properties": {
              "id": { "$ref": "#/definitions/exerciseId" },
              "name": { "$ref": "#/definitions/exerciseName" },
              "sets": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": { "$ref": "#/definitions/fightReps" }
              }
            }
          }
        }
      }
    },
    "campaignConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "level", "exercise", "sets"],
      "properties": {
        "mode": { "enum": ["campaign"] },
        "level": { "$ref": "#/definitions/levelId" },
        "exercise": { "$ref": "#/definitions/exercise" },
        "sets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 199,
          "items": { "$ref": "#/definitions/setReps" }
        }
      }
    },

    "fightGridResult": {
      "description": "Every set of a fight, done or not. The fight is won when every set is done (§6).",
      "type": "object",
      "additionalProperties": false,
      "required": ["exercises", "outcome"],
      "properties": {
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["exercise", "sets"],
            "properties": {
              "exercise": { "$ref": "#/definitions/exercise" },
              "sets": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": { "$ref": "#/definitions/fightSetResult" }
              }
            }
          }
        },
        "outcome": { "$ref": "#/definitions/decisiveOutcome" }
      }
    },
    "fightSetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "done"],
      "properties": {
        "target": { "$ref": "#/definitions/fightReps" },
        "done": { "type": "boolean" }
      }
    },
    "campaignResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sets", "outcome"],
      "properties": {
        "sets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 199,
          "items": { "$ref": "#/definitions/campaignSetResult" }
        },
        "outcome": { "$ref": "#/definitions/decisiveOutcome" }
      }
    },
    "campaignSetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "done"],
      "properties": {
        "target": { "$ref": "#/definitions/setReps" },
        "done": { "type": "boolean" }
      }
    },
    "duelConfig": {
      "description": "The sets of a round of the duel from the one the last battle stopped at: from is the place of the first of them in the round.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "round", "from", "sets"],
      "properties": {
        "mode": { "enum": ["duel"] },
        "round": { "$ref": "#/definitions/levelId" },
        "from": { "type": "integer", "minimum": 0, "maximum": 198 },
        "sets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 199,
          "items": { "$ref": "#/definitions/duelSet" }
        }
      }
    },
    "duelSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exercise", "reps"],
      "properties": {
        "exercise": { "$ref": "#/definitions/exercise" },
        "reps": { "$ref": "#/definitions/setReps" }
      }
    },
    "duelResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sets", "outcome"],
      "properties": {
        "sets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 199,
          "items": { "$ref": "#/definitions/duelSetResult" }
        },
        "outcome": { "$ref": "#/definitions/decisiveOutcome" }
      }
    },
    "duelSetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exercise", "target", "done"],
      "properties": {
        "exercise": { "$ref": "#/definitions/exercise" },
        "target": { "$ref": "#/definitions/setReps" },
        "done": { "type": "boolean" }
      }
    },

    "fightBattleGame": {
      "description": "A fight of the game always takes the energy of fights (§24.4).",
      "type": "object",
      "additionalProperties": false,
      "required": ["pool", "energyFullAt"],
      "properties": {
        "pool": { "enum": ["fight"] },
        "energyFullAt": { "$ref": "#/definitions/instant" }
      }
    },
    "campaignGame": {
      "description": "A level of the journey and a battle of the duel always take the energy of the journey (§24.4).",
      "type": "object",
      "additionalProperties": false,
      "required": ["pool", "energyFullAt"],
      "properties": {
        "pool": { "enum": ["campaign"] },
        "energyFullAt": { "$ref": "#/definitions/instant" }
      }
    },
    "levelId": {
      "description": "A level of the journey: its campaign, stage and number, such as forest-ravens/1/4.",
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[1-9][0-9]?/[1-9][0-9]?$"
    },
    "attemptId": {
      "description": "UUID v7 created by the browser when the attempt starts.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/definitions/exerciseId" },
        "name": { "$ref": "#/definitions/exerciseName" }
      }
    },
    "exerciseId": {
      "description": "The slug of a ready exercise or the UUID of a custom one.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "exerciseName": { "type": "string", "minLength": 1, "maxLength": 60 },
    "instant": {
      "description": "UTC time as Date.prototype.toISOString() writes it.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "duration": { "type": "integer", "minimum": 0, "maximum": 31536000000 },
    "setReps": { "type": "integer", "minimum": 1, "maximum": 100 },
    "fightReps": { "type": "integer", "minimum": 1, "maximum": 999 },
    "decisiveOutcome": { "enum": ["win", "loss"] }
  }
}
