{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "A finished attempt, format version 4",
  "description": "The structure and limits of an attempt; the game rules stay in frontend/src/domain. Version 4 puts a fight of the game together freely from exercises and rounds (§6); the old modes of the site stay readable for the attempts the history keeps. Version 3 marked the battles of the game and added the levels of its journey (§24). The API also accepts versions 2 and 3 and stores them as version 4; version 2 knows no game and becomes a workout of the site. Section 3.7 of the plan.",
  "oneOf": [
    { "$ref": "#/definitions/fightAttempt" },
    { "$ref": "#/definitions/targetAttempt" },
    { "$ref": "#/definitions/randomOpponentAttempt" },
    { "$ref": "#/definitions/opponentLevelsAttempt" },
    { "$ref": "#/definitions/ladderAttempt" },
    { "$ref": "#/definitions/campaignAttempt" }
  ],
  "if": { "properties": { "schemaVersion": { "const": 2 } } },
  "then": { "not": { "required": ["game"] } },
  "else": { "required": ["game"] },
  "definitions": {
    "targetAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "startedAt", "finishedAt", "durationMs", "challenge", "mode", "config", "result"],
      "properties": {
        "schemaVersion": { "enum": [2, 3, 4] },
        "id": { "$ref": "#/definitions/attemptId" },
        "startedAt": { "$ref": "#/definitions/instant" },
        "finishedAt": { "$ref": "#/definitions/instant" },
        "durationMs": { "$ref": "#/definitions/duration" },
        "challenge": { "$ref": "#/definitions/challengeRef" },
        "game": { "$ref": "#/definitions/fightGame" },
        "mode": { "enum": ["target"] },
        "config": { "$ref": "#/definitions/targetConfig" },
        "result": { "$ref": "#/definitions/fightResult" }
      }
    },
    "randomOpponentAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "startedAt", "finishedAt", "durationMs", "challenge", "mode", "config", "result"],
      "properties": {
        "schemaVersion": { "enum": [2, 3, 4] },
        "id": { "$ref": "#/definitions/attemptId" },
        "startedAt": { "$ref": "#/definitions/instant" },
        "finishedAt": { "$ref": "#/definitions/instant" },
        "durationMs": { "$ref": "#/definitions/duration" },
        "challenge": { "$ref": "#/definitions/challengeRef" },
        "game": { "$ref": "#/definitions/fightGame" },
        "mode": { "enum": ["random-opponent"] },
        "config": { "$ref": "#/definitions/randomOpponentConfig" },
        "result": { "$ref": "#/definitions/fightResult" }
      }
    },
    "opponentLevelsAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "startedAt", "finishedAt", "durationMs", "challenge", "mode", "config", "result"],
      "properties": {
        "schemaVersion": { "enum": [2, 3, 4] },
        "id": { "$ref": "#/definitions/attemptId" },
        "startedAt": { "$ref": "#/definitions/instant" },
        "finishedAt": { "$ref": "#/definitions/instant" },
        "durationMs": { "$ref": "#/definitions/duration" },
        "challenge": { "$ref": "#/definitions/challengeRef" },
        "game": { "$ref": "#/definitions/fightGame" },
        "mode": { "enum": ["opponent-levels"] },
        "config": { "$ref": "#/definitions/opponentLevelsConfig" },
        "result": { "$ref": "#/definitions/fightResult" }
      }
    },
    "ladderAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "startedAt", "finishedAt", "durationMs", "challenge", "mode", "config", "result"],
      "properties": {
        "schemaVersion": { "enum": [2, 3, 4] },
        "id": { "$ref": "#/definitions/attemptId" },
        "startedAt": { "$ref": "#/definitions/instant" },
        "finishedAt": { "$ref": "#/definitions/instant" },
        "durationMs": { "$ref": "#/definitions/duration" },
        "challenge": { "$ref": "#/definitions/challengeRef" },
        "game": { "$ref": "#/definitions/fightGame" },
        "mode": { "enum": ["ladder"] },
        "config": { "$ref": "#/definitions/ladderConfig" },
        "result": { "$ref": "#/definitions/ladderResult" }
      }
    },
    "fightAttempt": {
      "description": "Version 4: a fight of the game the player puts together (§6). It always takes the energy of fights and no ready-made challenge.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "startedAt", "finishedAt", "durationMs", "challenge", "game", "mode", "config", "result"],
      "properties": {
        "schemaVersion": { "enum": [4] },
        "id": { "$ref": "#/definitions/attemptId" },
        "startedAt": { "$ref": "#/definitions/instant" },
        "finishedAt": { "$ref": "#/definitions/instant" },
        "durationMs": { "$ref": "#/definitions/duration" },
        "challenge": { "type": "null" },
        "game": { "$ref": "#/definitions/fightBattleGame" },
        "mode": { "enum": ["fight"] },
        "config": { "$ref": "#/definitions/fightConfig" },
        "result": { "$ref": "#/definitions/fightGridResult" }
      }
    },
    "campaignAttempt": {
      "description": "Version 3: a level of the journey of the game (§24.5). It takes no ready-made challenge of the site.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "startedAt", "finishedAt", "durationMs", "challenge", "game", "mode", "config", "result"],
      "properties": {
        "schemaVersion": { "enum": [3, 4] },
        "id": { "$ref": "#/definitions/attemptId" },
        "startedAt": { "$ref": "#/definitions/instant" },
        "finishedAt": { "$ref": "#/definitions/instant" },
        "durationMs": { "$ref": "#/definitions/duration" },
        "challenge": { "type": "null" },
        "game": { "$ref": "#/definitions/campaignGame" },
        "mode": { "enum": ["campaign"] },
        "config": { "$ref": "#/definitions/campaignConfig" },
        "result": { "$ref": "#/definitions/campaignResult" }
      }
    },

    "fightConfig": {
      "description": "Version 4: the exercises of a fight with the repetitions of every round; every exercise has as many rounds (§6).",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "exercises"],
      "properties": {
        "mode": { "enum": ["fight"] },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "sets"],
            "properties": {
              "id": { "$ref": "#/definitions/exerciseId" },
              "name": { "$ref": "#/definitions/exerciseName" },
              "sets": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": { "$ref": "#/definitions/fightReps" }
              }
            }
          }
        }
      }
    },
    "targetConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "rule", "rounds", "exercises"],
      "properties": {
        "mode": { "enum": ["target"] },
        "rule": { "$ref": "#/definitions/rule" },
        "rounds": { "$ref": "#/definitions/rounds" },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "targets"],
            "properties": {
              "id": { "$ref": "#/definitions/exerciseId" },
              "name": { "$ref": "#/definitions/exerciseName" },
              "targets": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": { "$ref": "#/definitions/reps" }
              }
            }
          }
        }
      }
    },
    "randomOpponentConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "rule", "rounds", "exercises"],
      "properties": {
        "mode": { "enum": ["random-opponent"] },
        "rule": { "$ref": "#/definitions/rule" },
        "rounds": { "$ref": "#/definitions/rounds" },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "min", "max"],
            "properties": {
              "id": { "$ref": "#/definitions/exerciseId" },
              "name": { "$ref": "#/definitions/exerciseName" },
              "min": { "$ref": "#/definitions/opponentBound" },
              "max": { "$ref": "#/definitions/opponentBound" }
            }
          }
        }
      }
    },
    "opponentLevelsConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "rule", "rounds", "difficulty", "exercises"],
      "properties": {
        "mode": { "enum": ["opponent-levels"] },
        "rule": { "$ref": "#/definitions/rule" },
        "rounds": { "$ref": "#/definitions/rounds" },
        "difficulty": { "enum": ["easy", "medium", "hard"] },
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "upperBound"],
            "properties": {
              "id": { "$ref": "#/definitions/exerciseId" },
              "name": { "$ref": "#/definitions/exerciseName" },
              "upperBound": { "$ref": "#/definitions/opponentBound" }
            }
          }
        }
      }
    },
    "ladderConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "rule", "exercise", "max", "returnDown"],
      "properties": {
        "mode": { "enum": ["ladder"] },
        "rule": { "$ref": "#/definitions/rule" },
        "exercise": { "$ref": "#/definitions/exercise" },
        "max": { "$ref": "#/definitions/ladderStep" },
        "returnDown": { "type": "boolean" }
      }
    },
    "campaignConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "level", "exercise", "sets"],
      "properties": {
        "mode": { "enum": ["campaign"] },
        "level": { "$ref": "#/definitions/levelId" },
        "exercise": { "$ref": "#/definitions/exercise" },
        "sets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 199,
          "items": { "$ref": "#/definitions/setReps" }
        }
      }
    },

    "fightGridResult": {
      "description": "Version 4: every set of a fight, done or not. The fight is won when every set is done (§6).",
      "type": "object",
      "additionalProperties": false,
      "required": ["exercises", "outcome"],
      "properties": {
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["exercise", "sets"],
            "properties": {
              "exercise": { "$ref": "#/definitions/exercise" },
              "sets": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10,
                "items": { "$ref": "#/definitions/fightSetResult" }
              }
            }
          }
        },
        "outcome": { "$ref": "#/definitions/decisiveOutcome" }
      }
    },
    "fightSetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "done"],
      "properties": {
        "target": { "$ref": "#/definitions/fightReps" },
        "done": { "type": "boolean" }
      }
    },
    "fightResult": {
      "description": "Versions 2 and 3: the rounds of the old modes against a goal or an opponent.",
      "type": "object",
      "additionalProperties": false,
      "required": ["rounds", "won", "drawn", "lost", "outcome"],
      "properties": {
        "rounds": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/definitions/roundResult" }
        },
        "won": { "$ref": "#/definitions/roundCount" },
        "drawn": { "$ref": "#/definitions/roundCount" },
        "lost": { "$ref": "#/definitions/roundCount" },
        "outcome": { "$ref": "#/definitions/outcome" }
      }
    },
    "roundResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exercises", "won", "lost", "outcome"],
      "properties": {
        "exercises": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/definitions/exerciseResult" }
        },
        "won": { "$ref": "#/definitions/roundCount" },
        "lost": { "$ref": "#/definitions/roundCount" },
        "outcome": { "$ref": "#/definitions/outcome" }
      }
    },
    "exerciseResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exercise", "target", "actual", "outcome"],
      "properties": {
        "exercise": { "$ref": "#/definitions/exercise" },
        "target": { "$ref": "#/definitions/reps" },
        "actual": { "$ref": "#/definitions/reps" },
        "outcome": { "$ref": "#/definitions/decisiveOutcome" }
      }
    },
    "ladderResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stages", "maxPassed", "passedCount", "outcome"],
      "properties": {
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 199,
          "items": { "$ref": "#/definitions/ladderStageResult" }
        },
        "maxPassed": { "type": "integer", "minimum": 0, "maximum": 100 },
        "passedCount": { "type": "integer", "minimum": 0, "maximum": 199 },
        "outcome": { "$ref": "#/definitions/decisiveOutcome" }
      }
    },
    "ladderStageResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "actual", "passed"],
      "properties": {
        "target": { "$ref": "#/definitions/ladderStep" },
        "actual": { "type": ["integer", "null"], "minimum": 0, "maximum": 9999 },
        "passed": { "type": "boolean" }
      }
    },
    "campaignResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sets", "outcome"],
      "properties": {
        "sets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 199,
          "items": { "$ref": "#/definitions/campaignSetResult" }
        },
        "outcome": { "$ref": "#/definitions/decisiveOutcome" }
      }
    },
    "campaignSetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "done"],
      "properties": {
        "target": { "$ref": "#/definitions/setReps" },
        "done": { "type": "boolean" }
      }
    },

    "challengeRef": {
      "description": "Version 2: the ready-made challenge the attempt took with the settings of its page, or null.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["slug", "title"],
          "properties": {
            "slug": { "type": "string", "maxLength": 80, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
            "title": { "type": "string", "minLength": 1, "maxLength": 160 }
          }
        }
      ]
    },
    "fightGame": {
      "description": "Version 3: null for a workout of the site, or a fight of the game with the pool of energy it took and the moment that pool is full again (§24.4).",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["pool", "energyFullAt"],
          "properties": {
            "pool": { "enum": ["fight"] },
            "energyFullAt": { "$ref": "#/definitions/instant" }
          }
        }
      ]
    },
    "fightBattleGame": {
      "description": "Version 4: a fight of the game always takes the energy of fights (§24.4).",
      "type": "object",
      "additionalProperties": false,
      "required": ["pool", "energyFullAt"],
      "properties": {
        "pool": { "enum": ["fight"] },
        "energyFullAt": { "$ref": "#/definitions/instant" }
      }
    },
    "campaignGame": {
      "description": "Version 3: a level of the journey always takes the energy of the journey (§24.4).",
      "type": "object",
      "additionalProperties": false,
      "required": ["pool", "energyFullAt"],
      "properties": {
        "pool": { "enum": ["campaign"] },
        "energyFullAt": { "$ref": "#/definitions/instant" }
      }
    },
    "levelId": {
      "description": "A level of the journey: its campaign, stage and number, such as forest-ravens/1/4.",
      "type": "string",
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[1-9][0-9]?/[1-9][0-9]?$"
    },
    "attemptId": {
      "description": "UUID v7 created by the browser when the attempt starts.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "exercise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/definitions/exerciseId" },
        "name": { "$ref": "#/definitions/exerciseName" }
      }
    },
    "exerciseId": {
      "description": "The slug of a ready exercise or the UUID of a custom one.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "exerciseName": { "type": "string", "minLength": 1, "maxLength": 60 },
    "instant": {
      "description": "UTC time as Date.prototype.toISOString() writes it.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "duration": { "type": "integer", "minimum": 0, "maximum": 31536000000 },
    "rule": { "enum": ["over", "meet"] },
    "rounds": { "type": "integer", "minimum": 1, "maximum": 20 },
    "roundCount": { "type": "integer", "minimum": 0, "maximum": 20 },
    "reps": { "type": "integer", "minimum": 0, "maximum": 9999 },
    "opponentBound": { "type": "integer", "minimum": 1, "maximum": 100 },
    "ladderStep": { "type": "integer", "minimum": 1, "maximum": 100 },
    "setReps": { "type": "integer", "minimum": 1, "maximum": 100 },
    "fightReps": { "type": "integer", "minimum": 1, "maximum": 999 },
    "outcome": { "enum": ["win", "draw", "loss"] },
    "decisiveOutcome": { "enum": ["win", "loss"] }
  }
}
