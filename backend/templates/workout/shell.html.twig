{% extends 'base.html.twig' %}

{% block meta %}
    <meta name="robots" content="noindex, follow">
{% endblock %}

{% block assets %}
    {{ vite_entry_link_tags('app') }}
    {{ vite_entry_script_tags('app', { dependency: 'react' }) }}
{% endblock %}

{% block body %}
    {#- The data the game needs before its first request: the ready-made exercises. #}
    <div id="root" data-game="{{ game|json_encode }}"></div>
    <noscript><p class="app-noscript">{{ 'workout.noscript'|trans }}</p></noscript>
{% endblock %}
