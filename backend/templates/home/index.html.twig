{% extends 'site/layout.html.twig' %}

{# The landing (§3.1 of the specification): what the cossack game is and how to play it, drawn as the
   game draws its screens. The pictures are copies of those of the game (home/art). #}

{% set title = 'home.title'|trans %}
{% set description = 'home.description'|trans %}
{% set indexable = true %}

{%- set campaigns = ['black-flag', 'steppe-wolves', 'forest-ravens'] %}
{#- §24.2: the first rank of every look of the cossack and the glory it takes. #}
{%- set looks = [
    {look: 'recruit', glory: 0},
    {look: 'cossack', glory: 45},
    {look: 'officer', glory: 330},
    {look: 'general', glory: 1150},
    {look: 'hetman', glory: 3500},
] %}
{#- §24.3: what the glory comes for. #}
{%- set rewards = [
    {key: 'fight', glory: 1},
    {key: 'level', glory: 2},
    {key: 'boss', glory: 5},
    {key: 'round', glory: 5},
    {key: 'campaign', glory: 10},
    {key: 'journey', glory: 30},
] %}

{% block title %}{{ title }}{% endblock %}

{% block meta %}
    {{ include('site/_social.html.twig') }}
    {%- set site = {name: 'site.name'|trans, alternateName: 'site.alternate_name'|trans, url: site_url ~ path('home')} %}
    {{ include('site/_json_ld.html.twig', {data: [
        {'@context': 'https://schema.org', '@type': 'WebSite', inLanguage: 'uk'}|merge(site),
        {'@context': 'https://schema.org', '@type': 'Organization', logo: site_url ~ '/apple-touch-icon.png'}|merge(site),
    ]}) }}
{% endblock %}

{% block main %}
    <section class="landing-hero" aria-labelledby="hero-title">
        <div class="container landing-hero__inner">
            <div class="landing-hero__text">
                <p class="eyebrow eyebrow--gold">{{ 'home.hero.eyebrow'|trans }}</p>
                <h1 class="landing-hero__title" id="hero-title">{{ 'home.hero.title'|trans }}</h1>
                <p class="landing-hero__lead">{{ 'home.hero.lead'|trans }}</p>
                <div class="landing-hero__actions">
                    <a class="button button--primary button--large" href="{{ path('kozak_fight') }}">
                        {{- 'site.start'|trans -}}
                        <svg class="button__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </a>
                    <a class="button button--outline button--large" href="{{ path('kozak_journey') }}">{{ 'home.hero.journey'|trans }}</a>
                </div>
                <p class="landing-hero__note">
                    <svg class="landing-hero__note-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    {{- 'home.no_signup'|trans -}}
                </p>
            </div>
            <div class="landing-hero__figure" aria-hidden="true">{{ include('home/art/hero.svg.twig') }}</div>
        </div>
    </section>

    <section class="container landing-section" id="game" aria-labelledby="game-title">
        <header class="landing-head">
            <p class="eyebrow eyebrow--gold">{{ 'home.game.eyebrow'|trans }}</p>
            <h2 class="landing-head__title" id="game-title">{{ 'home.game.title'|trans }}</h2>
            <p class="landing-head__lead">{{ 'home.game.lead'|trans }}</p>
        </header>
        <ul class="landing-features" role="list">
            <li class="landing-card">
                <svg class="landing-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.5 17.5 3 6V3h3l11.5 11.5M13 19l6-6M16 16l4 4M19 21l2-2M9.5 17.5 21 6V3h-3L6.5 14.5M11 19l-6-6M8 16l-4 4M5 21l-2-2"/></svg>
                <h3 class="landing-card__title">{{ 'home.game.fight.name'|trans }}</h3>
                <p class="landing-card__text">{{ 'home.game.fight.text'|trans }}</p>
            </li>
            <li class="landing-card">
                <svg class="landing-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 21V4M5 4h11l-2 4 2 4H5"/></svg>
                <h3 class="landing-card__title">{{ 'home.game.journey.name'|trans }}</h3>
                <p class="landing-card__text">{{ 'home.game.journey.text'|trans }}</p>
            </li>
            <li class="landing-card">
                <svg class="landing-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.2l7.1-.6z"/></svg>
                <h3 class="landing-card__title">{{ 'home.game.glory.name'|trans }}</h3>
                <p class="landing-card__text">{{ 'home.game.glory.text'|trans }}</p>
            </li>
            <li class="landing-card">
                <svg class="landing-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>
                <h3 class="landing-card__title">{{ 'home.game.energy.name'|trans }}</h3>
                <p class="landing-card__text">{{ 'home.game.energy.text'|trans }}</p>
            </li>
        </ul>
    </section>

    {#- §6: a fight is put together freely from exercises and rounds. #}
    <section class="container landing-section landing-fight" aria-labelledby="fight-title">
        <div class="landing-fight__text">
            <header class="landing-head">
                <p class="eyebrow eyebrow--gold">{{ 'home.fight.eyebrow'|trans }}</p>
                <h2 class="landing-head__title" id="fight-title">{{ 'home.fight.title'|trans }}</h2>
                <p class="landing-head__lead">{{ 'home.fight.lead'|trans }}</p>
            </header>
            <ul class="landing-checks" role="list">
                {%- for point in ['order', 'done', 'win'] %}
                <li class="landing-checks__item">
                    <svg class="landing-checks__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    {{- ('home.fight.points.' ~ point)|trans -}}
                </li>
                {%- endfor %}
            </ul>
        </div>
        {{ include('home/_fight_preview.html.twig') }}
    </section>

    {#- §24.5: three campaigns and the duel with the King of robbers. #}
    <section class="container landing-section" aria-labelledby="journey-title">
        <header class="landing-head">
            <p class="eyebrow eyebrow--gold">{{ 'home.journey.eyebrow'|trans }}</p>
            <h2 class="landing-head__title" id="journey-title">{{ 'home.journey.title'|trans }}</h2>
            <p class="landing-head__lead">{{ 'home.journey.lead'|trans }}</p>
        </header>
        <ul class="landing-campaigns" role="list">
            {%- for campaign in campaigns %}
            <li class="landing-campaign">
                <div class="landing-campaign__art" aria-hidden="true">{{ include('home/art/campaign-' ~ campaign ~ '.svg.twig') }}</div>
                <div class="landing-campaign__body">
                    <h3 class="landing-campaign__name">{{ ('home.journey.' ~ campaign ~ '.name')|trans }}</h3>
                    <p class="landing-campaign__exercise">{{ ('home.journey.' ~ campaign ~ '.exercise')|trans }}</p>
                    <p class="landing-campaign__lead">{{ ('home.journey.' ~ campaign ~ '.lead')|trans }}</p>
                </div>
            </li>
            {%- endfor %}
            <li class="landing-campaign landing-campaign--final">
                <div class="landing-campaign__art" aria-hidden="true">{{ include('home/art/campaign-final-battle.svg.twig') }}</div>
                <div class="landing-campaign__body">
                    <h3 class="landing-campaign__name">{{ 'home.journey.final-battle.name'|trans }}</h3>
                    <p class="landing-campaign__exercise landing-campaign__exercise--boss">{{ 'home.journey.final-battle.exercise'|trans }}</p>
                    <p class="landing-campaign__lead">{{ 'home.journey.final-battle.lead'|trans }}</p>
                </div>
            </li>
        </ul>
        <p class="landing-note">{{ 'home.journey.stages'|trans }}</p>
    </section>

    {#- §24.2: twenty ranks in five looks, from a dzhura up to the hetman. #}
    <section class="container landing-section" aria-labelledby="ranks-title">
        <header class="landing-head">
            <p class="eyebrow eyebrow--gold">{{ 'home.ranks.eyebrow'|trans }}</p>
            <h2 class="landing-head__title" id="ranks-title">{{ 'home.ranks.title'|trans }}</h2>
            <p class="landing-head__lead">{{ 'home.ranks.lead'|trans }}</p>
        </header>
        <ol class="landing-ranks" role="list">
            {%- for item in looks %}
            <li class="landing-rank{{ loop.last ? ' landing-rank--top' }}">
                <div class="landing-rank__figure" aria-hidden="true">{{ include('home/art/cossack-' ~ item.look ~ '.svg.twig') }}</div>
                <div class="landing-rank__text">
                    <p class="landing-rank__name">{{ ('home.ranks.looks.' ~ item.look)|trans }}</p>
                    <p class="landing-rank__glory">{{ 'home.ranks.from'|trans({'%glory%': item.glory|number_format(0, ',', ' ')}) }}</p>
                </div>
            </li>
            {%- endfor %}
        </ol>
        <div class="landing-rewards">
            <h3 class="landing-rewards__title">{{ 'home.ranks.rewards.title'|trans }}</h3>
            <ul class="landing-rewards__list" role="list">
                {%- for reward in rewards %}
                <li class="landing-reward"><b class="landing-reward__glory">+{{ reward.glory }}</b> {{ ('home.ranks.rewards.' ~ reward.key)|trans }}</li>
                {%- endfor %}
            </ul>
        </div>
    </section>

    <section class="container landing-section" aria-labelledby="how-title">
        <header class="landing-head">
            <h2 class="landing-head__title" id="how-title">{{ 'home.how.title'|trans }}</h2>
        </header>
        <ol class="landing-steps" role="list">
            {%- for step in ['open', 'choose', 'play'] %}
            <li class="landing-step">
                <span class="landing-step__number" aria-hidden="true">{{ loop.index }}</span>
                <h3 class="landing-step__title">{{ ('home.how.' ~ step ~ '.title')|trans }}</h3>
                <p class="landing-step__text">{{ ('home.how.' ~ step ~ '.text')|trans }}</p>
            </li>
            {%- endfor %}
        </ol>
    </section>

    <section class="container landing-section" aria-labelledby="cta-title">
        <div class="landing-cta">
            <h2 class="landing-cta__title" id="cta-title">{{ 'home.cta.title'|trans }}</h2>
            <a class="button button--primary button--large" href="{{ path('kozak_fight') }}">{{ 'site.start'|trans }}</a>
            <p class="landing-cta__note">{{ 'home.no_signup'|trans }}</p>
        </div>
    </section>
{% endblock %}
