{% extends 'site/layout.html.twig' %}

{# The landing (§3.1 of the specification, design/Main.dc.html). #}

{% set title = 'home.title'|trans %}
{% set description = 'home.description'|trans %}
{% set indexable = true %}

{% block title %}{{ title }}{% endblock %}

{% block meta %}
    {{ include('site/_social.html.twig') }}
    {%- set site = {name: 'site.name'|trans, alternateName: 'site.alternate_name'|trans, url: site_url ~ path('home')} %}
    {{ include('site/_json_ld.html.twig', {data: [
        {'@context': 'https://schema.org', '@type': 'WebSite', inLanguage: 'uk'}|merge(site),
        {'@context': 'https://schema.org', '@type': 'Organization', logo: site_url ~ '/apple-touch-icon.png'}|merge(site),
    ]}) }}
{% endblock %}

{% block main %}
    <section class="hero stripes" aria-labelledby="hero-title">
        <div class="container hero__inner">
            <div class="hero__text">
                <p class="eyebrow hero__eyebrow">{{ 'home.hero.eyebrow'|trans }}</p>
                <h1 class="hero__title" id="hero-title">{{ 'home.hero.title'|trans }}</h1>
                <p class="hero__lead">{{ 'home.hero.lead'|trans }}</p>
                <div class="hero__actions">
                    <a class="button button--primary button--large" href="{{ path('kozak_fight') }}">
                        {{- 'site.start'|trans -}}
                        <svg class="button__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </a>
                    <p class="hero__note">
                        <svg class="hero__note-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                        {{- 'home.no_signup'|trans -}}
                    </p>
                </div>
            </div>
            {{ include('home/_fight_preview.html.twig') }}
        </div>
    </section>

    {#- §6: a fight is put together freely, and the journey of the game leads on. #}
    <section class="container section" id="game" aria-labelledby="game-title">
        <div class="section__head">
            <h2 class="section__title" id="game-title">{{ 'home.game.title'|trans }}</h2>
            <p class="section__lead">{{ 'home.game.lead'|trans }}</p>
        </div>
        <ul class="features" role="list">
            <li class="card feature-card">
                <span class="feature-card__number" aria-hidden="true">01</span>
                <svg class="feature-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M3 9h18M3 15h18M9 3v18M15 3v18"/></svg>
                <h3 class="feature-card__title">{{ 'home.game.grid.name'|trans }}</h3>
                <p class="feature-card__text">{{ 'home.game.grid.text'|trans }}</p>
            </li>
            <li class="card feature-card">
                <span class="feature-card__number" aria-hidden="true">02</span>
                <svg class="feature-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5L16 9.5"/></svg>
                <h3 class="feature-card__title">{{ 'home.game.sets.name'|trans }}</h3>
                <p class="feature-card__text">{{ 'home.game.sets.text'|trans }}</p>
            </li>
            <li class="card feature-card">
                <span class="feature-card__number" aria-hidden="true">03</span>
                <svg class="feature-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.2l7.1-.6z"/></svg>
                <h3 class="feature-card__title">{{ 'home.game.glory.name'|trans }}</h3>
                <p class="feature-card__text">{{ 'home.game.glory.text'|trans }}</p>
            </li>
            <li class="card feature-card">
                <span class="feature-card__number" aria-hidden="true">04</span>
                <svg class="feature-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 21V4M5 4h11l-2 4 2 4H5"/></svg>
                <h3 class="feature-card__title">{{ 'home.game.journey.name'|trans }}</h3>
                <p class="feature-card__text">{{ 'home.game.journey.text'|trans }}</p>
            </li>
        </ul>
    </section>

    <section class="container section" id="how" aria-labelledby="how-title">
        <div class="section__head">
            <h2 class="section__title" id="how-title">{{ 'home.how.title'|trans }}</h2>
        </div>
        <ol class="steps">
            <li class="step">
                <span class="step__number" aria-hidden="true">1</span>
                <h3 class="step__title">{{ 'home.how.setup.title'|trans }}</h3>
                <p class="step__text">{{ 'home.how.setup.text'|trans }}</p>
            </li>
            <li class="step">
                <span class="step__number" aria-hidden="true">2</span>
                <h3 class="step__title">{{ 'home.how.exercise.title'|trans }}</h3>
                <p class="step__text">{{ 'home.how.exercise.text'|trans }}</p>
            </li>
            <li class="step">
                <span class="step__number" aria-hidden="true">3</span>
                <h3 class="step__title">{{ 'home.how.result.title'|trans }}</h3>
                <p class="step__text">{{ 'home.how.result.text'|trans }}</p>
            </li>
        </ol>
    </section>

    <section class="container section" aria-labelledby="why-title">
        <div class="section__head">
            <h2 class="section__title" id="why-title">{{ 'home.why.title'|trans }}</h2>
        </div>
        <ul class="benefits" role="list">
            <li class="benefit">
                <h3 class="benefit__title">{{ 'home.why.goal.title'|trans }}</h3>
                <p class="benefit__text">{{ 'home.why.goal.text'|trans }}</p>
            </li>
            <li class="benefit">
                <h3 class="benefit__title">{{ 'home.why.progress.title'|trans }}</h3>
                <p class="benefit__text">{{ 'home.why.progress.text'|trans }}</p>
            </li>
            <li class="benefit">
                <h3 class="benefit__title">{{ 'home.why.no_signup.title'|trans }}</h3>
                <p class="benefit__text">{{ 'home.why.no_signup.text'|trans }}</p>
            </li>
            <li class="benefit">
                <h3 class="benefit__title">{{ 'home.why.exercises.title'|trans }}</h3>
                <p class="benefit__text">{{ 'home.why.exercises.text'|trans }}</p>
            </li>
        </ul>
    </section>

    <section class="container section" aria-labelledby="cta-title">
        <div class="cta stripes">
            <h2 class="cta__title" id="cta-title">{{ 'home.cta.title'|trans }}</h2>
            <a class="button button--primary button--large" href="{{ path('kozak_fight') }}">{{ 'site.start'|trans }}</a>
            <p class="cta__note">{{ 'home.no_signup'|trans }}</p>
        </div>
    </section>
{% endblock %}
