{% extends 'site/layout.html.twig' %}

{% block title %}{{ 'error.not_found.title'|trans }} — {{ 'site.name'|trans }}{% endblock %}

{% block main %}
    <div class="container error-page">
        <p class="eyebrow error-page__code">{{ 'error.code'|trans({'%code%': status_code}) }}</p>
        <h1 class="error-page__title">{{ 'error.not_found.title'|trans }}</h1>
        <p class="error-page__text">{{ 'error.not_found.text'|trans }}</p>
        <div class="error-page__actions">
            <a class="button button--primary button--large" href="{{ path('home') }}">{{ 'error.home'|trans }}</a>
            <a class="button button--outline button--large" href="{{ path('kozak_fight') }}">{{ 'site.start'|trans }}</a>
        </div>
    </div>
{% endblock %}
