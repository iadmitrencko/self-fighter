{#- The score of the player on every page, the main reason to come back (§14.2). The page is the
    same for everyone, so the numbers arrive from the API: src/score/score.ts fills them in. #}
<section class="score" aria-labelledby="score-title">
    <div class="container score__inner">
        <p class="score__title" id="score-title">{{ 'site.score.title'|trans }}</p>
        <dl class="score__list">
            {% for key in ['total', 'wins', 'draws', 'losses', 'challenges'] %}
                <div class="score__item score__item--{{ key }}">
                    <dt class="score__label">{{ ('site.score.' ~ key)|trans }}</dt>
                    <dd class="score__value" data-score="{{ key }}">–</dd>
                </div>
            {% endfor %}
        </dl>
    </div>
</section>
