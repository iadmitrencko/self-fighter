<!doctype html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}{{ 'site.name'|trans }}{% endblock %}</title>
    {#- A page opens itself to search engines with `indexable`; drafts, the game and the errors stay
        closed, and so does every environment but production (SEO_INDEXING). #}
    {% if not (seo_indexing and indexable|default(false)) %}
        <meta name="robots" content="noindex, follow">
    {% endif %}
    {% block meta %}{% endblock %}
    <meta name="theme-color" content="#111214">
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    {% block assets %}
        {{ vite_entry_link_tags('site') }}
        {{ vite_entry_script_tags('site') }}
    {% endblock %}
</head>
<body{% block body_attributes %}{% endblock %}>
    {% block body %}{% endblock %}
</body>
</html>
