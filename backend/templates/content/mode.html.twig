{% extends 'content/layout.html.twig' %}

{#- A mode of the game (§21.2): how it works, an example and its ready-made challenges. #}

{% set article = page.article %}
{% set title = article.title %}
{% set description = article.description %}
{% set heading = article.heading %}
{% set lead = article.lead %}
{% set indexable = page.indexable %}
{% set breadcrumbs = [
    {name: 'site.footer.home'|trans, path: path('home')},
    {name: 'site.nav.modes'|trans, path: path('modes')},
    {name: heading},
] %}

{% block eyebrow %}<p class="eyebrow page-head__eyebrow">{{ 'mode_page.eyebrow'|trans }}</p>{% endblock %}

{% block actions %}
    <a class="button button--primary button--large page-head__action" href="{{ path('workout_setup', {mode: page.slug}) }}">{{ 'mode_page.start'|trans }}</a>
{% endblock %}

{% block content %}
    <div class="prose">{{ article.html|raw }}</div>
    <section class="page-section" aria-labelledby="challenges">
        <h2 class="page-section__title" id="challenges">{{ 'mode_page.challenges_title'|trans }}</h2>
        {% if challenges is not empty %}
            {{ include('content/_challenge_list.html.twig', {heading_level: 3}) }}
        {% else %}
            <p class="page-section__text">{{ 'mode_page.no_challenges'|trans }} <a href="{{ path('challenges') }}">{{ 'content.all_challenges'|trans }}</a></p>
        {% endif %}
    </section>
{% endblock %}
