{% extends 'content/layout.html.twig' %}

{#- A guide answers a question people search for (§21.2) and leads to the game. #}

{% set article = page.article %}
{% set title = article.title %}
{% set description = article.description %}
{% set heading = article.heading %}
{% set lead = article.lead %}
{% set indexable = page.indexable %}
{% set og_type = 'article' %}
{% set breadcrumbs = [
    {name: 'site.footer.home'|trans, path: path('home')},
    {name: 'site.nav.guides'|trans, path: path('guides')},
    {name: heading},
] %}

{% block structured_data %}
    {%- set organization = {'@type': 'Organization', name: 'site.name'|trans, url: site_url ~ path('home')} %}
    {{ include('site/_json_ld.html.twig', {data: {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: heading,
        description: description,
        image: [site_url ~ '/og.png'],
        dateModified: page.updatedAt|date('Y-m-d'),
        inLanguage: 'uk',
        mainEntityOfPage: site_url ~ path('guide', {slug: page.slug}),
        author: organization,
        publisher: organization|merge({logo: {'@type': 'ImageObject', url: site_url ~ '/apple-touch-icon.png'}}),
    }}) }}
{% endblock %}

{% block eyebrow %}<p class="eyebrow page-head__eyebrow">{{ 'guide_page.eyebrow'|trans }}</p>{% endblock %}

{% block content %}
    <div class="prose">{{ article.html|raw }}</div>
    <div class="page-cta">
        <a class="button button--primary button--large" href="{{ path('workout') }}">{{ 'site.start'|trans }}</a>
        <a class="button button--outline button--large" href="{{ path('challenges') }}">{{ 'content.all_challenges'|trans }}</a>
    </div>
{% endblock %}
