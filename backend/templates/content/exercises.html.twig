{% extends 'content/layout.html.twig' %}

{% set title = 'exercises.title'|trans %}
{% set description = 'exercises.description'|trans %}
{% set heading = 'exercises.heading'|trans %}
{% set lead = 'exercises.lead'|trans %}
{% set indexable = true %}
{% set breadcrumbs = [{name: 'site.footer.home'|trans, path: path('home')}, {name: 'site.nav.exercises'|trans}] %}

{% block content %}
    {{ include('content/_cards.html.twig', {items: exercises|map(exercise => {
        path: path('exercise', {slug: exercise.slug}),
        heading: exercise.article.heading,
        text: exercise.article.lead,
    })}) }}
{% endblock %}
