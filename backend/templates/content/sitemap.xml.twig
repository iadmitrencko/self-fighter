<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for url in urls %}
    <url>
        <loc>{{ site_url }}{{ url.path }}</loc>
        {%- if url.updated %}
        <lastmod>{{ url.updated|date('Y-m-d') }}</lastmod>
        {%- endif %}
    </url>
{% endfor %}
</urlset>
