{% extends 'content/layout.html.twig' %}

{#- The catalog of ready-made challenges (§21.3): every challenge is reachable from here. #}

{% set title = 'challenges.title'|trans %}
{% set description = 'challenges.description'|trans %}
{% set heading = 'challenges.heading'|trans %}
{% set lead = 'challenges.lead'|trans %}
{% set indexable = true %}
{% set breadcrumbs = [{name: 'site.footer.home'|trans, path: path('home')}, {name: 'site.nav.challenges'|trans}] %}

{% block actions %}
    {#- §21.3: how much of the catalog the visitor has passed, counted by src/score/score.ts. #}
    <p class="catalog-progress">
        <span class="catalog-progress__label">{{ 'challenges.progress'|trans }}</span>
        <span class="catalog-progress__value"><span data-score-catalog>–</span> / {{ groups|reduce((total, group) => total + group.challenges|length, 0) }}</span>
    </p>
{% endblock %}

{% block content %}
    {% for group in groups %}
        <section class="page-section" aria-labelledby="group-{{ loop.index }}">
            <h2 class="page-section__title" id="group-{{ loop.index }}">
                {{- group.exercise ? group.exercise.name : 'challenges.mixed'|trans -}}
            </h2>
            {{ include('content/_challenge_list.html.twig', {challenges: group.challenges, heading_level: 3}) }}
        </section>
    {% endfor %}
{% endblock %}
