# Docker Compose settings for local development.
# `make up` copies this file to .env when .env does not exist.

# Host ports
HTTP_PORT=8080
VITE_PORT=5173
MYSQL_PORT=3307

# MySQL (development credentials only)
MYSQL_VERSION=9.7
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root

# Xdebug mode: off, debug, develop or coverage
XDEBUG_MODE=off

# Signing in with Google in development: the client of the development project from section 11
# of the plan, with http://localhost:8080/connect/google/check as its redirect URI. Without it the
# game hides the sign-in button. Never commit the secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
